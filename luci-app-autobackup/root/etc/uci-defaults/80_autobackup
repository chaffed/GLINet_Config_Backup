#!/bin/sh
# First run after install or upgrade.
touch /etc/config/autobackup_auth
chmod 600 /etc/config/autobackup_auth
uci -q get autobackup_auth.main >/dev/null || { uci set autobackup_auth.main=auth; uci commit autobackup_auth; }
chmod 600 /etc/config/autobackup_auth
# When settings are kept across an upgrade, opkg leaves the package's own
# copies next to them; nothing reads those.
rm -f /etc/config/autobackup-opkg /etc/config/autobackup_auth-opkg
mkdir -p /etc/autobackup
chmod 700 /etc/autobackup
# A passphrase is kept only while encryption is on (an unencrypted backup
# must not carry it); settings edited by hand are brought back in line.
if [ "$(uci -q get autobackup.main.encrypt)" != 1 ] && [ -n "$(uci -q get autobackup_auth.main.passphrase)" ]; then
	printf "\nconfig auth 'main'\n" > /etc/config/autobackup_auth
	chmod 600 /etc/config/autobackup_auth
fi

# The rpcd plugin and the menu entry: visible without a reboot.
rm -f /tmp/luci-indexcache* 2>/dev/null
rm -rf /tmp/luci-modulecache 2>/dev/null
/etc/init.d/rpcd reload 2>/dev/null

# reload_config only notices changes to configs it already has a checksum
# for; register ours so the first "Save & Apply" applies the schedule.
if [ -f /var/run/config.md5 ] && ! grep -q '/var/run/config.check/autobackup$' /var/run/config.md5; then
	mkdir -p /var/run/config.check
	uci show autobackup > /var/run/config.check/autobackup 2>/dev/null
	md5sum /var/run/config.check/autobackup >> /var/run/config.md5
	rm -rf /var/run/config.check
fi

# GL.iNet admin panel: its web server keeps a panel module in memory once
# it has been used, so reload it (gracefully) to pick up a new version.
if [ -d /usr/lib/oui-httpd/rpc ] && [ -s /var/run/nginx.pid ] && [ -x /usr/sbin/nginx ]; then
	/usr/sbin/nginx -s reload 2>/dev/null
fi

/etc/init.d/autobackup enable 2>/dev/null
# The schedule as the settings say (also after a restore brought back
# settings with another schedule).
/usr/bin/autobackup cron-sync 2>/dev/null
exit 0
