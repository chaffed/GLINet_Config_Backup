#!/bin/sh
# Auto Backup (luci-app-autobackup): the router's configuration, saved to a
# USB drive on a schedule, and restored by hand.
#
#   autobackup backup [--scheduled]  save a backup now (prints JSON)
#   autobackup list                  backups on the drive (JSON)
#   autobackup delete ID             remove one backup (ID = folder/name)
#   autobackup status                drive, last result, schedule (JSON)
#   autobackup config                the settings (JSON; never the passphrase)
#   autobackup set KEY=VALUE...      check and store settings, then apply the schedule
#   autobackup passphrase-input      make a root-only file for a passphrase (prints its name)
#   autobackup set-passphrase FILE|- store the passphrase in FILE (or stdin) and encrypt from now on
#   autobackup cron-sync             write the schedule into cron (init script)
#   autobackup cron-remove           take it out of cron (package removal)
#   autobackup version
#
# Where things are:
#   <drive>/autobackup/<hostname>/<model>_<firmware>_<YYYYMMDD-HHMMSS>.tar.gz
#   (.tar.gz.enc when encrypted), with a record of it next to it (.json):
#   the router it came from, its firmware, size, sha256 and the packages
#   installed on top of the firmware (a backup holds settings, not packages).
#   /etc/autobackup/last   the last run's result (kept across firmware upgrades)
#
# Encryption (optional): openssl enc -aes-256-cbc -pbkdf2 -iter 200000.
# The passphrase lives only in /etc/config/autobackup_auth (root only). It
# never goes into a command's arguments (any process can read those), a
# log, or anything printed: openssl reads it from a root-only file, and
# the pages hand it over in one (passphrase-input). Setting a passphrase
# turns encryption on, and turning encryption off forgets it, so a
# backup that is not encrypted never holds the passphrase (a backup holds
# Auto Backup's own settings too).
#
# A drive is a mounted file system under /tmp/mountd/ (GL.iNet) or /mnt/
# (OpenWrt's block-mount). An unplugged drive's mount point is a folder in
# the router's own memory or flash, so nothing is ever written to a path
# that is not a mount point: a run without a drive is stored as failed,
# with its reason, and writes nothing.
#
# Every command that changes something takes the lock, so a scheduled run
# and "Back up now" never run at once (the second one answers "busy").
#
# SPDX-License-Identifier: MIT
# shellcheck shell=dash

VERSION=0.1.0

STATE_DIR=/etc/autobackup
LAST="$STATE_DIR/last"
LOCK=/var/lock/autobackup.lock
TMP_DIR=/tmp/autobackup
MOUNTS=/proc/mounts
RUN_DIR=/var/run/autobackup
AUTH=/etc/config/autobackup_auth
CRONTAB=/etc/crontabs/root
CRON_MARK="# autobackup"
# Only this model and firmware have been tested so far; the pages say so.
TESTED="be9300:4.10.1"

umask 077

# ---------------------------------------------------------------- helpers --

log() { logger -t autobackup "$*" 2>/dev/null; }

# A JSON string. Control characters are dropped (none of our values has a
# reason to contain one).
jstr() {
	printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# A JSON array of strings, one per line of input.
jlist() {
	local first=1 line
	printf '['
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		[ $first = 1 ] || printf ','
		first=0
		jstr "$line"
	done
	printf ']'
}

jbool() { if [ "$1" = 1 ]; then printf true; else printf false; fi; }

# Whole number, else the default.
num() {
	case "$1" in
		''|*[!0-9]*) echo "$2" ;;
		*) echo "$1" ;;
	esac
}

# A file or folder name made of safe characters only.
safe_name() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-64; }

cfg() { uci -q get "autobackup.main.$1"; }

hostname_() {
	local h
	h=$(uci -q get system.@system[0].hostname)
	safe_name "${h:-OpenWrt}"
}

# Short model name: GL.iNet's own (be9300), else the board name.
model() {
	local m=""
	[ -r /proc/gl-hw-info/model ] && m=$(tr -d '\n' < /proc/gl-hw-info/model)
	[ -n "$m" ] || m=$(board)
	safe_name "${m:-unknown}"
}

board() { [ -r /tmp/sysinfo/board_name ] && tr -d '\n' < /tmp/sysinfo/board_name; }
model_name() { [ -r /tmp/sysinfo/model ] && tr -d '\n' < /tmp/sysinfo/model; }

openwrt_release() {
	# shellcheck disable=SC1091
	( . /etc/openwrt_release 2>/dev/null; printf '%s' "${DISTRIB_RELEASE:-}" )
}

# GL.iNet's firmware version (4.10.1), else OpenWrt's release.
firmware() {
	local v=""
	[ -r /etc/glversion ] && v=$(tr -d '\n' < /etc/glversion)
	[ -n "$v" ] || v=$(openwrt_release)
	printf '%s' "${v:-unknown}"
}

is_tested() {
	[ "$(model):$(firmware)" = "$TESTED" ] && echo 1 || echo 0
}

# Packages installed on top of the firmware: in opkg's list but not in the
# firmware's own (/rom). Without /rom (not a squashfs image) they cannot
# be told apart, and the record says so (packages_known false).
user_packages() {
	[ -r /rom/usr/lib/opkg/status ] || return 1
	awk '
		FNR == 1 { file++ }
		/^Package:/ { p = $2 }
		/^Status:/ && / installed/ { if (file == 1) rom[p] = 1; else if (!(p in rom)) print p }
	' /rom/usr/lib/opkg/status /usr/lib/opkg/status | sort -u
}

file_size() { wc -c < "$1" | tr -d ' '; }
sha256() { sha256sum "$1" | cut -d' ' -f1; }

# ---------------------------------------------------------------- drives --

# Mounted drives, one mount point per line. Mount points with spaces or
# other escaped characters are left out (GL.iNet and block-mount never make
# them).
drives() {
	awk '$2 ~ /^\/(tmp\/mountd|mnt)\/[A-Za-z0-9._-]+$/ &&
		$3 !~ /^(tmpfs|ramfs|overlay|squashfs|proc|sysfs|devtmpfs|devpts|cgroup2?)$/ { print $2 }' "$MOUNTS" 2>/dev/null | sort -u
}

is_mounted() {
	drives | grep -qxF "$1"
}

# The drive to use: the one in the settings, else the first one found.
# Sets DRIVE to its mount point, or fails with the reason in DRIVE_REASON.
# Call it directly, not in $(...), or both are lost.
resolve_drive() {
	local want
	want=$(cfg drive)
	DRIVE=""
	DRIVE_REASON=""
	if [ -n "$want" ]; then
		if is_mounted "$want"; then
			DRIVE=$want
			return 0
		fi
		DRIVE_REASON=drive_missing
		return 1
	fi
	DRIVE=$(drives | head -n 1)
	[ -n "$DRIVE" ] && return 0
	DRIVE_REASON=no_drive
	return 1
}

# -P: one line per file system, however long its name.
free_kb() { df -kP "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'; }

# ------------------------------------------------------------ work files --

# Set WORK to a root-only scratch name in RAM ($TMP_DIR/<what>.<pid>);
# everything starting with it is removed when this process ends. Call it
# directly, not in $(...), or the clean-up is set in a subshell.
WORK=""
work_file() {
	mkdir -p "$TMP_DIR"
	chmod 700 "$TMP_DIR"
	WORK="$TMP_DIR/$1.$$"
	rm -f "$WORK" "$WORK".*
	trap 'cleanup' EXIT
	trap 'exit 1' INT TERM
}

cleanup() {
	[ -n "$WORK" ] && rm -f "$WORK" "$WORK".*
}

# --------------------------------------------------------------- the lock --

# Take the lock for the rest of this process, or fail at once.
lock() {
	mkdir -p "${LOCK%/*}"
	exec 9>"$LOCK"
	flock -n 9
}

is_busy() {
	mkdir -p "${LOCK%/*}"
	( exec 9>"$LOCK"; flock -n 9 ) 2>/dev/null && echo 0 || echo 1
}

# ------------------------------------------------------------ last result --

# record_result ok|failed REASON FILE
record_result() {
	local now last_ok
	now=$(date +%s)
	last_ok=$(state_get last_ok)
	[ "$1" = ok ] && last_ok=$now
	mkdir -p "$STATE_DIR"
	chmod 700 "$STATE_DIR"
	{
		echo "result=$1"
		echo "reason=$2"
		echo "time=$now"
		echo "file=$3"
		echo "last_ok=${last_ok:-0}"
	} > "$LAST.tmp" && mv "$LAST.tmp" "$LAST"
}

state_get() {
	[ -r "$LAST" ] && sed -n "s/^$1=//p" "$LAST" | head -n 1
}

fail() {
	# fail REASON [DETAIL]: store and print a failed run.
	record_result failed "$1" ""
	log "backup failed: $1${2:+ ($2)}"
	printf '{"ok":false,"reason":%s,"detail":%s}\n' "$(jstr "$1")" "$(jstr "${2:-}")"
	exit 1
}

# --------------------------------------------------------------- settings --

# check_setting KEY VALUE: is VALUE allowed for KEY?
check_setting() {
	case "$1" in
		schedule) case "$2" in off|daily|weekly) return 0 ;; esac ;;
		weekday) in_range "$2" 0 6 && return 0 ;;
		hour) in_range "$2" 0 23 && return 0 ;;
		minute) in_range "$2" 0 59 && return 0 ;;
		keep) in_range "$2" 1 100 && return 0 ;;
		encrypt) case "$2" in 0|1) return 0 ;; esac ;;
		drive)
			[ -z "$2" ] && return 0
			printf '%s' "$2" | grep -qE '^/(tmp/mountd|mnt)/[A-Za-z0-9._-]+$' && return 0
			;;
	esac
	return 1
}

SETTINGS="schedule weekday hour minute keep drive encrypt"

in_range() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ ${#1} -le 3 ] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

passphrase_set() {
	[ -n "$(uci -q get autobackup_auth.main.passphrase)" ] && echo 1 || echo 0
}

# Write the passphrase file (empty: no passphrase). Written by hand, not
# with `uci set`, which would take the passphrase as an argument.
write_auth() {
	local new="$AUTH.new.$$"
	{
		echo
		echo "config auth 'main'"
		if [ -n "$1" ]; then
			printf "\toption passphrase '%s'\n" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
		fi
	} > "$new" && chmod 600 "$new" && mv "$new" "$AUTH"
}

# Copy the stored passphrase into a root-only file for openssl.
passphrase_file() {
	uci -q get autobackup_auth.main.passphrase > "$1"
	[ -s "$1" ]
}

# A passphrase: 8 to 256 characters on one line, no control characters.
passphrase_ok() {
	local n
	n=$(printf '%s' "$1" | wc -c)
	[ "$n" -ge 8 ] && [ "$n" -le 256 ] && [ -z "$(printf '%s' "$1" | tr -d -c '\000-\037\177')" ]
}

# A root-only file for a passphrase typed on a page; the caller writes it
# and hands its name to set-passphrase or restore, which delete it.
cmd_passphrase_input() {
	local f
	mkdir -p "$RUN_DIR"
	chmod 700 "$RUN_DIR"
	# Leftovers of pages that never came back.
	find "$RUN_DIR" -name 'input.*' -mmin +10 -exec rm -f {} + 2>/dev/null
	f=$(mktemp "$RUN_DIR/input.XXXXXX") || exit 1
	chmod 600 "$f"
	echo "$f"
}

# Only files passphrase-input made (or stdin).
read_input() {
	local p=""
	case "$1" in
		-) IFS= read -r p ;;
		"$RUN_DIR"/input.*)
			case "$1" in *..*|*/.*) return 1 ;; esac
			[ -f "$1" ] || return 1
			IFS= read -r p < "$1"
			rm -f "$1"
			;;
		*) return 1 ;;
	esac
	printf '%s' "$p"
}

cmd_set_passphrase() {
	local p
	p=$(read_input "$1") || { printf '{"ok":false,"reason":"no_input"}\n'; exit 1; }
	if ! passphrase_ok "$p"; then
		printf '{"ok":false,"reason":"invalid_passphrase","field":"passphrase"}\n'
		exit 1
	fi
	write_auth "$p" || { printf '{"ok":false,"reason":"write_failed"}\n'; exit 1; }
	uci -q get autobackup.main >/dev/null || uci set autobackup.main=autobackup
	uci set autobackup.main.encrypt=1
	uci commit autobackup
	log "passphrase set; backups are encrypted from now on"
	printf '{"ok":true}\n'
}

cmd_config() {
	local k first=1
	printf '{'
	for k in $SETTINGS; do
		[ $first = 1 ] || printf ','
		first=0
		printf '%s:%s' "$(jstr "$k")" "$(jstr "$(cfg "$k")")"
	done
	printf ',"passphrase_set":%s}\n' "$(jbool "$(passphrase_set)")"
}

# Nothing is stored unless every value is valid.
cmd_set() {
	local kv k v enc=""
	[ $# -gt 0 ] || { printf '{"ok":false,"reason":"nothing_to_set"}\n'; exit 1; }
	for kv in "$@"; do
		k=${kv%%=*}
		v=${kv#*=}
		case "$kv" in *=*) ;; *) k=$kv v="" ;; esac
		case " $SETTINGS " in *" $k "*) ;; *)
			printf '{"ok":false,"reason":"unknown_setting","field":%s}\n' "$(jstr "$k")"
			exit 1 ;;
		esac
		if ! check_setting "$k" "$v"; then
			printf '{"ok":false,"reason":"invalid_value","field":%s}\n' "$(jstr "$k")"
			exit 1
		fi
		[ "$k" = encrypt ] && enc=$v
	done
	# Encryption needs a passphrase first (a backup must never quietly
	# fall back to an unencrypted file).
	if [ "$enc" = 1 ] && [ "$(passphrase_set)" = 0 ]; then
		printf '{"ok":false,"reason":"no_passphrase","field":"encrypt"}\n'
		exit 1
	fi
	uci -q get autobackup.main >/dev/null || uci set autobackup.main=autobackup
	for kv in "$@"; do
		k=${kv%%=*}
		v=${kv#*=}
		case "$kv" in *=*) ;; *) v="" ;; esac
		uci set "autobackup.main.$k=$v"
	done
	uci commit autobackup
	# Encryption off forgets the passphrase (see the top of this file).
	if [ "$enc" = 0 ] && [ "$(passphrase_set)" = 1 ]; then
		write_auth ""
		log "encryption switched off; passphrase forgotten"
	fi
	cron_sync
	printf '{"ok":true}\n'
}

# ------------------------------------------------------------- schedule --

cron_line() {
	local s m h d
	s=$(cfg schedule)
	m=$(num "$(cfg minute)" 30)
	h=$(num "$(cfg hour)" 3)
	d=$(num "$(cfg weekday)" 0)
	in_range "$m" 0 59 || m=30
	in_range "$h" 0 23 || h=3
	in_range "$d" 0 6 || d=0
	case "$s" in
		daily) echo "$m $h * * * /usr/bin/autobackup backup --scheduled >/dev/null 2>&1 $CRON_MARK" ;;
		weekly) echo "$m $h * * $d /usr/bin/autobackup backup --scheduled >/dev/null 2>&1 $CRON_MARK" ;;
	esac
}

# Replace our line in root's crontab (only ever the line with our mark),
# and restart cron when it changed.
cron_write() {
	local want="$1" now new
	mkdir -p "${CRONTAB%/*}"
	now=$(grep -F "$CRON_MARK" "$CRONTAB" 2>/dev/null)
	[ "$now" = "$want" ] && return 0
	new="$CRONTAB.autobackup.$$"
	{
		[ -f "$CRONTAB" ] && grep -vF "$CRON_MARK" "$CRONTAB"
		[ -n "$want" ] && echo "$want"
	} > "$new"
	chmod 600 "$new"
	mv "$new" "$CRONTAB"
	if [ -x /etc/init.d/cron ]; then
		/etc/init.d/cron enable 2>/dev/null
		/etc/init.d/cron restart >/dev/null 2>&1
	fi
	return 0
}

cron_sync() { cron_write "$(cron_line)"; }

# When the schedule runs next (Unix time), or 0 when off. Local time, as
# cron runs it.
next_run() {
	local s m h d now hh mm ss wd t ahead
	s=$(cfg schedule)
	case "$s" in daily|weekly) ;; *) echo 0; return ;; esac
	m=$(num "$(cfg minute)" 30)
	h=$(num "$(cfg hour)" 3)
	d=$(num "$(cfg weekday)" 0)
	now=$(date +%s)
	# shellcheck disable=SC2046
	set -- $(date +'%H %M %S %w')
	hh=${1#0} mm=${2#0} ss=${3#0} wd=$4
	t=$((now - ${hh:-0} * 3600 - ${mm:-0} * 60 - ${ss:-0} + h * 3600 + m * 60))
	if [ "$s" = daily ]; then
		[ $t -le "$now" ] && t=$((t + 86400))
	else
		ahead=$(( (d - wd + 7) % 7 ))
		t=$((t + ahead * 86400))
		[ $t -le "$now" ] && t=$((t + 7 * 86400))
	fi
	echo $t
}

# ----------------------------------------------------------------- backup --

cmd_backup() {
	local drive dir host name stamp tmp out size sum archive ext enc detail n scheduled=0
	[ "$1" = --scheduled ] && scheduled=1
	if ! lock; then
		printf '{"ok":false,"reason":"busy","detail":""}\n'
		exit 1
	fi
	resolve_drive || fail "$DRIVE_REASON"
	drive=$DRIVE

	work_file backup
	tmp=$WORK

	detail=$(sysupgrade -b "$tmp.tar.gz" 2>&1)
	if [ ! -s "$tmp.tar.gz" ] || ! gzip -t "$tmp.tar.gz" 2>/dev/null; then
		fail backup_failed "$(printf '%s' "$detail" | tail -n 1)"
	fi
	out="$tmp.tar.gz"
	ext=tar.gz
	enc=0
	if [ "$(cfg encrypt)" = 1 ]; then
		passphrase_file "$tmp.pass" || fail no_passphrase
		if ! openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -in "$out" -out "$tmp.tar.gz.enc" -pass "file:$tmp.pass" 2>/dev/null ||
			[ ! -s "$tmp.tar.gz.enc" ]; then
			fail encrypt_failed
		fi
		rm -f "$tmp.pass" "$out"
		out="$tmp.tar.gz.enc"
		ext=tar.gz.enc
		enc=1
	fi

	size=$(file_size "$out")
	sum=$(sha256 "$out")

	host=$(hostname_)
	stamp=$(date +%Y%m%d-%H%M%S)
	name="$(model)_$(safe_name "$(firmware)")_$stamp"
	archive="$name.$ext"

	# The drive may have gone while the backup was made.
	is_mounted "$drive" || fail drive_missing
	dir="$drive/autobackup/$host"
	mkdir -p "$dir" 2>/dev/null || fail write_failed "cannot make $dir"
	# Two backups within a second ("Back up now" twice): number the second.
	n=1
	while [ -e "$dir/$name.json" ] || [ -e "$dir/$archive" ]; do
		n=$((n + 1))
		name="$(model)_$(safe_name "$(firmware)")_$stamp-$n"
		archive="$name.$ext"
	done

	if ! cp "$out" "$dir/$archive.part" 2>/dev/null || [ "$(sha256 "$dir/$archive.part")" != "$sum" ]; then
		rm -f "$dir/$archive.part"
		fail write_failed "the copy on the drive is incomplete (drive full?)"
	fi
	mv "$dir/$archive.part" "$dir/$archive" || fail write_failed "cannot rename on the drive"

	write_record "$dir/$name.json" "$archive" "$size" "$sum" "$enc" || {
		rm -f "$dir/$archive" "$dir/$name.json"
		fail write_failed "cannot write the record (drive full?)"
	}
	sync

	prune "$dir"
	record_result ok "" "$host/$name"
	if [ $scheduled = 1 ]; then
		log "scheduled backup saved: $dir/$archive"
	else
		log "backup saved: $dir/$archive"
	fi
	printf '{"ok":true,"id":%s,"file":%s,"size":%s}\n' "$(jstr "$host/$name")" "$(jstr "$dir/$archive")" "$size"
}

# write_record PATH ARCHIVE SIZE SHA256 ENCRYPTED
write_record() {
	local pk known=1
	pk=$(user_packages) || known=0
	{
		printf '{"format":1,"app_version":%s,"file":%s,"time":%s' "$(jstr "$VERSION")" "$(jstr "$2")" "$(date +%s)"
		printf ',"hostname":%s,"model":%s,"model_name":%s,"board":%s' \
			"$(jstr "$(hostname_)")" "$(jstr "$(model)")" "$(jstr "$(model_name)")" "$(jstr "$(board)")"
		printf ',"firmware":%s,"openwrt":%s' "$(jstr "$(firmware)")" "$(jstr "$(openwrt_release)")"
		printf ',"size":%s,"sha256":%s,"encrypted":%s' "$3" "$(jstr "$4")" "$(jbool "$5")"
		printf ',"packages_known":%s,"packages":%s}\n' "$(jbool $known)" "$(printf '%s\n' "$pk" | jlist)"
	} > "$1.part" && [ -s "$1.part" ] && mv "$1.part" "$1"
}

# Records in a folder, newest first: "key<TAB>path" lines, the key being
# the time and two digits more: backups made within the same second are
# told apart by their number (name-2, name-3).
records_by_time() {
	local r t n
	for r in "$1"/*.json; do
		[ -f "$r" ] || continue
		t=$(jsonfilter -i "$r" -e '@.time' 2>/dev/null)
		case "$t" in ''|*[!0-9]*) continue ;; esac
		n=${r%.json}
		n=${n##*-}
		case "$n" in ''|*[!0-9]*|???*) n=1 ;; esac
		# One number to sort on (busybox sort ignores per-key flags).
		printf '%s%02d\t%s\n' "$t" "$n" "$r"
	done | sort -rn
}

# The archive a record describes (only names in its own folder).
archive_of() {
	local f
	f=$(jsonfilter -i "$1" -e '@.file' 2>/dev/null)
	case "$f" in
		*/*|.*|'') return 1 ;;
	esac
	echo "${1%/*}/$f"
}

# Keep the newest `keep` backups in a folder; remove the rest.
prune() {
	local keep n=0 t r a
	keep=$(num "$(cfg keep)" 10)
	[ "$keep" -ge 1 ] || keep=1
	records_by_time "$1" | while IFS="$(printf '\t')" read -r t r; do
		n=$((n + 1))
		[ $n -le "$keep" ] && continue
		a=$(archive_of "$r") && rm -f "$a"
		rm -f "$r"
		log "removed old backup ${r##*/} (keeping $keep)"
	done
}

# ------------------------------------------------------------ list/delete --

cmd_list() {
	local drive first=1 d t r r2 a missing
	printf '{'
	if resolve_drive; then
		drive=$DRIVE
		printf '"drive":%s,"backups":[' "$(jstr "$drive")"
		for d in "$drive"/autobackup/*/; do
			[ -d "$d" ] || continue
			records_by_time "${d%/}"
		done | sort -rn | while IFS="$(printf '\t')" read -r t r; do
			missing=false
			a=$(archive_of "$r") || continue
			[ -f "$a" ] || missing=true
			[ $first = 1 ] || printf ','
			first=0
			r2=${r%.json}
			# The record, with its id (folder/name) and whether its archive is there.
			printf '%s' "$(sed "1s/^{/{\"id\":$(jstr "$(basename "${r%/*}")/${r2##*/}" | sed 's/[\/&]/\\&/g'),\"missing\":$missing,/" "$r")"
		done
		printf ']'
	else
		printf '"drive":"","reason":%s,"backups":[]' "$(jstr "$DRIVE_REASON")"
	fi
	printf '}\n'
}

# Check an ID (folder/name, safe characters only) and print the record's path.
record_path() {
	printf '%s' "$1" | grep -qE '^[A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*$' || return 1
	case "$1" in *..*) return 1 ;; esac
	resolve_drive || return 1
	[ -f "$DRIVE/autobackup/$1.json" ] || return 1
	echo "$DRIVE/autobackup/$1.json"
}

cmd_delete() {
	local r a
	if ! lock; then
		printf '{"ok":false,"reason":"busy"}\n'
		exit 1
	fi
	r=$(record_path "$1") || { printf '{"ok":false,"reason":"not_found"}\n'; exit 1; }
	a=$(archive_of "$r") && rm -f "$a"
	rm -f "$r"
	sync
	log "deleted backup $1"
	printf '{"ok":true}\n'
}

# ----------------------------------------------------------------- status --

cmd_status() {
	local free="" last_time
	printf '{"version":%s' "$(jstr "$VERSION")"
	if resolve_drive; then
		free=$(free_kb "$DRIVE")
		printf ',"drive":%s,"drive_reason":""' "$(jstr "$DRIVE")"
	else
		printf ',"drive":"","drive_reason":%s' "$(jstr "$DRIVE_REASON")"
	fi
	printf ',"free_kb":%s' "$(num "$free" null)"
	printf ',"drives":%s' "$(drives | jlist)"
	last_time=$(num "$(state_get time)" 0)
	if [ "$last_time" -gt 0 ]; then
		printf ',"last":{"result":%s,"reason":%s,"time":%s,"id":%s}' \
			"$(jstr "$(state_get result)")" "$(jstr "$(state_get reason)")" "$last_time" "$(jstr "$(state_get file)")"
	else
		printf ',"last":null'
	fi
	printf ',"last_ok":%s' "$(num "$(state_get last_ok)" 0)"
	printf ',"busy":%s' "$(jbool "$(is_busy)")"
	printf ',"router":{"hostname":%s,"model":%s,"model_name":%s,"board":%s,"firmware":%s}' \
		"$(jstr "$(hostname_)")" "$(jstr "$(model)")" "$(jstr "$(model_name)")" "$(jstr "$(board)")" "$(jstr "$(firmware)")"
	printf ',"tested":%s,"tested_on":%s' "$(jbool "$(is_tested)")" "$(jstr "$TESTED")"
	printf ',"schedule":%s,"next_run":%s' "$(jstr "$(cfg schedule)")" "$(next_run)"
	printf ',"keep":%s,"encrypt":%s,"passphrase_set":%s' "$(num "$(cfg keep)" 10)" \
		"$(jbool "$(cfg encrypt)")" "$(jbool "$(passphrase_set)")"
	printf '}\n'
}

# ------------------------------------------------------------------- main --

cmd="$1"
[ $# -gt 0 ] && shift
case "$cmd" in
	backup) cmd_backup "$@" ;;
	list) cmd_list ;;
	delete) cmd_delete "$1" ;;
	status) cmd_status ;;
	config) cmd_config ;;
	set) cmd_set "$@" ;;
	passphrase-input) cmd_passphrase_input ;;
	set-passphrase) cmd_set_passphrase "$1" ;;
	cron-sync) cron_sync ;;
	cron-remove) cron_write "" ;;
	version) echo "$VERSION" ;;
	*)
		echo "usage: autobackup backup|list|delete ID|status|config|set KEY=VALUE...|version" >&2
		exit 2
		;;
esac
